# Database
POSTGRES_USER=docuvate
POSTGRES_PASSWORD=docuvate
POSTGRES_DB=docuvate
DATABASE_URL=postgresql://docuvate:docuvate@localhost:5432/docuvate

# Compose guards (see docs/self-hosting.md)
# DOCUVATE_FRESH_STACK=0

# Valkey (Redis-compatible)
VALKEY_URL=redis://localhost:6379

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=docuvate
MINIO_SECRET_KEY=docuvate-secret
MINIO_BUCKET=documents

# Auth (required for Docker Compose: generate a random string, at least 32 characters)
# BETTER_AUTH_SECRET=
# After the first user: invite-only unless DV_ALLOW_SIGNUP=true
# DV_ALLOW_SIGNUP=false
BETTER_AUTH_URL=http://localhost:3001
# Password reset mail (Compose defaults to Mailpit; override for real SMTP)
# SMTP_URL=smtp://mailpit:1025
# MAIL_FROM=Docuvate <no-reply@docuvate.local>
# PASSWORD_RESET_MAIL_MODE=smtp

# Headless /v1 service API keys (JSON array). Each entry: keyId, secret, tenantUserId, claims[].
# DOCUVATE_SERVICE_API_KEYS=[{"keyId":"sync","secret":"dev-key","tenantUserId":"<user-uuid>","claims":["document:read","document:list","document:content:read"]}]
# Scanner SFTP ingress (Go service + API service routes)
# SFTP_INGEST_PORT=2222
# DOCUVATE_SFTP_INGEST_SERVICE_KEY=local-sftp-ingest-service-key
# DOCUVATE_SFTP_PUBLIC_HOST=localhost
# DOCUVATE_SFTP_PUBLIC_PORT=2222
# DOCUVATE_SFTP_FETCH_SYNC_INTERVAL_MS=60000
# ABAC_DENY_DOCUMENT_STATUSES=failed

# Worker
WORKER_URL=http://localhost:8000
WORKER_SECRET=worker-shared-secret
# Document chat (Compose brings up Ollama + pulls a small CPU model by default)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:1.5b
# OLLAMA_MEM_LIMIT=3g
# qwen3:4b optional — set OLLAMA_MEM_LIMIT=5g (or higher) before OLLAMA_MODEL=qwen3:4b
# DOCUMENT_CHAT_PROVIDER=rag-ollama
# OLLAMA_CHAT_TIMEOUT_MS=180000
# OLLAMA_CHAT_IDLE_TIMEOUT_MS=120000
# OLLAMA_NUM_CTX=4096
# OLLAMA_NUM_PREDICT=512
# OLLAMA_KEEP_ALIVE=30m
# DOCUMENT_CHAT_GENERATION_CONCURRENCY=1
# Fail pending/streaming assistant messages older than this (ms); startup reconcile + migration
# DOCUMENT_CHAT_GENERATION_STALE_MS=120000
# Emit citedRejectedClaims in error_detail for bench/cited_chat_eval.py
# DOCUVATE_CITED_CHAT_BENCH_STATS=1
# WORKER_RAG_CONTEXT_TIMEOUT_MS=120000
# RAG reranker gate (sigmoid score; default 0.28) and fusion fallback when reranker is down
# RAG_RERANKER_GATE_MIN=0.21
# RAG_FUSION_GATE_MIN=0.02
# DOCUVATE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3-int8
# Arena compare can wait for Paddle model download + OCR (default 10 min)
WORKER_COMPARE_TIMEOUT_MS=600000
# Background arena sample: every N successful extractions (0 = off, default 200)
ARENA_SAMPLE_RATE=200

# OpenTelemetry (compose sets OTEL_SDK_DISABLED=true; enable when SigNoz/Sentry is wired)
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=docuvate-api

# Web (local Vite dev — browser calls API directly)
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3001
# Optional clickable link in Connectors UI (defaults to repo path hint only)
# VITE_CONNECTORS_OAUTH_SETUP_DOC_URL=https://example.com/docs/connectors-oauth-setup.md

# Connector credentials (AES key for encrypted installation secrets)
DOCUVATE_CONNECTOR_SECRETS_KEY=dev-change-me-32-chars-minimum!!

# Connector OAuth (Gmail / Outlook mail sources)
# Public API base used when DOCUVATE_CONNECTOR_OAUTH_REDIRECT_URI is unset:
# DOCUVATE_API_PUBLIC_URL=http://localhost:3001
# Behind nginx (web proxies /api → api), use e.g. https://your-host.example/api
# Explicit callback override:
# DOCUVATE_CONNECTOR_OAUTH_REDIRECT_URI=http://localhost:3001/v1/connectors/oauth/callback
# DOCUVATE_GMAIL_OAUTH_CLIENT_ID=
# DOCUVATE_GMAIL_OAUTH_CLIENT_SECRET=
# DOCUVATE_OUTLOOK_OAUTH_CLIENT_ID=
# DOCUVATE_OUTLOOK_OAUTH_CLIENT_SECRET=

# Environment
NODE_ENV=development
