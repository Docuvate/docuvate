{
  "version": 1,
  "policy": {
    "forbidden_training_datasets": [
      "FUNSD",
      "XFUND",
      "DocVQA",
      "DocILE"
    ],
    "forbidden_load_key_substrings": [
      "funsd",
      "xfund",
      "docile",
      "lilt-roberta",
      "lilt-gottbert"
    ],
    "forbidden_substring_exceptions": [
      "donut-base-finetuned-docvqa"
    ]
  },
  "models": [
    {
      "id": "multilingual-e5-small",
      "display_name": "intfloat/multilingual-e5-small",
      "load_keys": [
        "intfloat/multilingual-e5-small",
        "onnx/model_quantized.onnx"
      ],
      "source": "https://huggingface.co/intfloat/multilingual-e5-small",
      "revision": "614241f622f53c4eeff9890bdc4f31cfecc418b3",
      "content_sha256": null,
      "license_spdx": "MIT",
      "size_bytes_approx": 118346824,
      "purpose": "Central document and query embeddings (384 dimensions) via ONNX Runtime int8 CPU (onnx/model_qint8_avx512_vnni.onnx at the pinned revision) for representation, retrieval, and tag suggestions.",
      "shipped_in_default_cpu_image": true,
      "training_data_summary": "Microsoft E5 contrastive pre-training on public web data; not fine-tuned on FUNSD, XFUND, or DocVQA."
    },
    {
      "id": "paddle-pp-ocrv4-mobile-latin",
      "display_name": "PaddleOCR PP-OCRv4 mobile (Latin / German)",
      "load_keys": [
        "paddleocr:PP-OCRv4-mobile-latin"
      ],
      "source": "https://github.com/PaddlePaddle/PaddleOCR",
      "revision": "PP-OCRv4",
      "content_sha256": null,
      "license_spdx": "Apache-2.0",
      "size_bytes_approx": 16777216,
      "purpose": "OCR detection and recognition for scanned documents when the pipeline engine uses PaddleOCR.",
      "shipped_in_default_cpu_image": true,
      "training_data_summary": "PaddleOCR PP-OCRv4 mobile weights; Latin script pack covers German and English receipts."
    },
    {
      "id": "docai-v0.3-cpu-bundle",
      "display_name": "Docuvate DocAI v0.3 CPU bundle",
      "load_keys": [
        "rapidocr:docai-v0.3-en-latin-rec",
        "docai:v0.3"
      ],
      "source": "https://github.com/Docuvate/docuvate",
      "revision": "0.3.0",
      "content_sha256": null,
      "license_spdx": "LicenseRef-Docuvate-SUL-1.0",
      "size_bytes_approx": 20971520,
      "purpose": "ONNX field head, F2 stacking head, link ranker, TF-IDF vocab, and bundled PP-OCRv5 rec weights for CE layout field extraction.",
      "shipped_in_default_cpu_image": true,
      "training_data_summary": "CORD-v2 train split for field/link heads (CC-BY-4.0 attribution). OCR weights Apache-2.0 (PaddleOCR/RapidAI)."
    },
    {
      "id": "ner-doc-int8-germeval",
      "display_name": "German layout NER (GermEval 2014 + synthetic)",
      "load_keys": [
        "docuvate:ner-doc-int8"
      ],
      "source": "https://github.com/Docuvate/docuvate",
      "revision": "p7-doc-head",
      "content_sha256": "fdfdf2360ea867739c9d61f24b3e85a4639686b46f17870c158085fff83a0810",
      "license_spdx": "CC-BY-4.0",
      "size_bytes_approx": 1441792,
      "purpose": "Vocabulary-free 2D-layout NER ONNX (int8) for value candidate typing (PER/ORG/LOC/DATE/MONEY).",
      "shipped_in_default_cpu_image": true,
      "training_data_summary": "GermEval 2014 Shared Task (CC-BY-4.0) plus Docuvate synthetic layout documents."
    },
    {
      "id": "donut-docvqa-optional",
      "display_name": "naver-clova-ix/donut-base-finetuned-docvqa",
      "load_keys": [
        "naver-clova-ix/donut-base-finetuned-docvqa"
      ],
      "source": "https://huggingface.co/naver-clova-ix/donut-base-finetuned-docvqa",
      "revision": "default",
      "content_sha256": null,
      "license_spdx": "MIT",
      "size_bytes_approx": 838860800,
      "purpose": "Optional GPU-only visual document QA when the worker is built with the donut extra.",
      "shipped_in_default_cpu_image": false,
      "allow_forbidden_substrings": true,
      "training_data_summary": "Fine-tuned on DocVQA. Not downloaded in the default CPU worker image; GPU optional extra only."
    },
    {
      "id": "docling-layout-optional",
      "display_name": "Docling layout pipeline (bundled models)",
      "load_keys": [
        "docling:layout-default"
      ],
      "source": "https://github.com/docling-project/docling",
      "revision": "package-default",
      "content_sha256": null,
      "license_spdx": "MIT",
      "size_bytes_approx": 524288000,
      "purpose": "Optional layout PDF extraction when EXTRACTOR_ENGINE=docling and the docling worker extra is installed.",
      "shipped_in_default_cpu_image": false,
      "training_data_summary": "Docling default layout models resolved by the docling package at runtime."
    },
    {
      "id": "tesseract-ocr-optional",
      "display_name": "Tesseract OCR (system language packs)",
      "load_keys": [
        "tesseract:deu+eng"
      ],
      "source": "https://github.com/tesseract-ocr/tesseract",
      "revision": "system-pack",
      "content_sha256": null,
      "license_spdx": "Apache-2.0",
      "size_bytes_approx": 52428800,
      "purpose": "Optional last-resort OCR when EXTRACTOR_ENGINE=tesseract and pytesseract is installed.",
      "shipped_in_default_cpu_image": false,
      "training_data_summary": "Classic OCR engine; language data installed separately on the host or image."
    }
  ],
  "artifacts": [
    {
      "id": "value_types_v1",
      "path": "apps/worker/models/value_types_v1.json",
      "sha256": "58e0270dbb2fb94463a9df4d4fe7929533a3328bcc447b08dc722e8a8d073c77"
    },
    {
      "id": "layout-kv-role-head",
      "path": "apps/worker/src/docuvate_worker/infrastructure/ml/artifacts/layout-kv-role-head.v1.json",
      "sha256": "630483711f5732801498c42b616162c48ff7c5a6b417693b80cfe6c815f3d951"
    },
    {
      "id": "ce-ml-calibration",
      "path": "apps/worker/src/docuvate_worker/infrastructure/ml/artifacts/ce-ml-calibration.v1.json",
      "sha256": "fc9a092813723f424e793a3d318cc4410e9baf04f84353dbce37c25f9c6ac0d5"
    },
    {
      "id": "docai-v0.3-config",
      "path": "apps/worker/models/docai_v0_3/model/config.json",
      "sha256": "70cff5c08c4be8daa8b08524a2dac429929f3c311c831351b40cb03f1604f7da"
    }
  ],
  "scan": {
    "python_globs": [
      "apps/worker/src/docuvate_worker/**/*.py"
    ],
    "typescript_paths": [
      "apps/api/src/shared/infrastructure/chat/ollama-chat-request.ts",
      "apps/api/src/shared/infrastructure/chat/document-chat-llm-config.ts",
      "apps/api/src/modules/settings/application/document-chat-provider-catalog.ts",
      "apps/api/src/modules/documents/application/run-document-chat-generation.use-case.ts",
      "apps/api/src/modules/settings/application/ollama-compose-memory.ts"
    ],
    "yaml_paths": [
      "docker-compose.yml",
      "deploy/kustomize/base/configmap-docuvate.yaml",
      "deploy/helm/docuvate/templates/configmap.yaml"
    ],
    "exclude_path_substrings": [
      "/tests/",
      ".spec.ts",
      ".integration.spec.ts",
      "/bench/",
      "/experiments/"
    ]
  }
}
