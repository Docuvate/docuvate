{
  "name": "@docuvate/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run -c vitest.config.ts && vitest run -c vitest.contract.config.ts",
    "test:unit": "vitest run -c vitest.config.ts",
    "test:contract": "vitest run -c vitest.contract.config.ts",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:coverage": "vitest run -c vitest.config.ts --coverage",
    "db:migrate": "node scripts/run-migrations.mjs",
    "auth:reset-password": "node dist/scripts/auth-reset-password.js",
    "openapi:export": "nest build && node --import tsx scripts/export-openapi.mts"
  },
  "dependencies": {
    "@docuvate/contracts": "workspace:*",
    "@docuvate/otel": "workspace:*",
    "@fastify/multipart": "^9.0.0",
    "@nestjs/common": "^11.0.10",
    "@nestjs/core": "^11.0.10",
    "@nestjs/platform-fastify": "^11.0.10",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/typeorm": "11.0.0",
    "better-auth": "^1.7.7",
    "bullmq": "^5.25.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.4.0",
    "minio": "^8.0.0",
    "nodemailer": "^7.0.6",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "0.3.24",
    "umap-js": "^1.4.0",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "@docuvate/testing": "workspace:*",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.0",
    "@vitest/coverage-v8": "^2.1.0",
    "fastify": "^5.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
