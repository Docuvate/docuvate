{
  "name": "@docuvate/sdk",
  "version": "1.0.0",
  "description": "Official TypeScript client for the Docuvate /v1 headless API",
  "license": "AGPL-3.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md", "CHANGELOG.md"],
  "scripts": {
    "codegen": "openapi-ts -c @hey-api/client-fetch -i ../../openapi/docuvate.v1.json -o src/generated",
    "build": "pnpm codegen && tsc -p tsconfig.json && node scripts/build-cjs.mjs",
    "typecheck": "pnpm codegen && tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@hey-api/client-fetch": "^0.8.1"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.64.1",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
