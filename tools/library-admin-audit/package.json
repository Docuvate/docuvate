  "private": true,
  "description": "Self-contained Docuvate CE library/admin use-case audit. Copy this directory to /tmp; it does not need the Docuvate checkout.",
  "license": "LicenseRef-Docuvate-SUL-1.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "playwright test",
