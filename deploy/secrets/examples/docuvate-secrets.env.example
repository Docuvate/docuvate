# Copy to a local file and create Secret: kubectl create secret generic docuvate-secrets --from-env-file=...
# Replace every REPLACE* value (openssl rand -hex 32 for BETTER_AUTH_SECRET). Documented placeholders are rejected at runtime.
DATABASE_URL=postgresql://docuvate:REPLACE@docuvate-postgres:5432/docuvate
BETTER_AUTH_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
BETTER_AUTH_URL=https://your-public-url
DOCUVATE_API_PUBLIC_URL=https://your-public-url/api
WEB_ORIGIN=https://your-public-url
MINIO_ACCESS_KEY=docuvate
MINIO_SECRET_KEY=REPLACE
WORKER_SECRET=REPLACE
DOCUVATE_CONNECTOR_SECRETS_KEY=REPLACE
